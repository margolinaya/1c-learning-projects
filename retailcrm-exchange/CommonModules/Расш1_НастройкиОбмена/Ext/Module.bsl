Функция ПолучениеНастроек() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Расш1_НастройкиОбмена.АдресCRM КАК АдресCRM,
		|	Расш1_НастройкиОбмена.APIключ КАК APIключ,
		|	Расш1_НастройкиОбмена.КодМагазина КАК КодМагазина,
		|   Расш1_НастройкиОбмена.Организация КАК Организация,
		|   Расш1_НастройкиОбмена.Склад КАК Склад
		|ИЗ
		|	РегистрСведений.Расш1_НастройкиОбмена КАК Расш1_НастройкиОбмена";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Результат = Новый Структура("Успех, Ошибка, Данные", Ложь, "", Неопределено);

	Если НЕ Выборка.Следующий() Тогда 
    	Результат.Ошибка = "Настройки обмена не заполнены.";
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Выборка.АдресCRM) 
		ИЛИ НЕ ЗначениеЗаполнено(Выборка.APIключ) 
		ИЛИ НЕ ЗначениеЗаполнено(Выборка.КодМагазина) Тогда
		Результат.Ошибка = "Заполнены не все настройки обмена. Проверьте адрес CRM, API-ключ и код магазина.";
		Возврат Результат;	
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.Данные = Выборка;
	Возврат Результат;
	
КонецФункции // ()  

Функция УстановкаСоединения(АдресCRM, Адрес, Метод = "GET", ТелоЗапроса = "") Экспорт

	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL; 
	Соединение = Новый HTTPСоединение(АдресCRM,,,,,30,ЗащищенноеСоединение,);
	
	ЗапросHTTP = Новый HTTPЗапрос(Адрес); 
	Ответ = Неопределено;
	ТекстСетевойОшибки = "";
	
	Результат = Новый Структура("Успех, Ошибка, Данные", Ложь,"", Неопределено);
	
	Если Метод = "POST" Тогда
        ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
        ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса);
    КонецЕсли;
	
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод(Метод, ЗапросHTTP);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ТекстСетевойОшибки = КраткоеПредставлениеОшибки(Ошибка);  
		
		ЗаписьЖурналаРегистрации(
	        "Обмен с RetailCRM.ОшибкаСети",
	        УровеньЖурналаРегистрации.Ошибка,
	        ,
	        ,
	        "Ошибка сети при обращении к CRM." + Символы.ПС +
	        "Технический текст: " + ТекстСетевойОшибки + Символы.ПС +
	        "URL запроса: " + Адрес
	    );
		
		ПонятныйТекст = Расш1_НастройкиОбмена.РасшифроватьОшибку(ТекстСетевойОшибки); 
		Результат.Ошибка = ПонятныйТекст;
		Возврат Результат;
	КонецПопытки; 
	
	Если Ответ.КодСостояния < 200 ИЛИ Ответ.КодСостояния >= 300 Тогда
		ТелоОшибки = Ответ.ПолучитьТелоКакСтроку();
	
	    ЗаписьЖурналаРегистрации(
	        "Обмен с RetailCRM.ОшибкаAPI",
	        УровеньЖурналаРегистрации.Ошибка,
	        ,
	        ,
	        "Код состояния: " + Ответ.КодСостояния + Символы.ПС +
	        "Ответ CRM: " + ТелоОшибки
	    );
	
	    Результат.Ошибка = "CRM вернула ошибку. Код: " + Ответ.КодСостояния;
	    Возврат Результат;
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.Данные = Ответ.ПолучитьТелоКакСтроку(); 

	Возврат Результат;

КонецФункции // ()

Функция ЧтениеJSON(ТелоОтвета, Адрес) Экспорт
	
	Результат = Новый Структура("Успех, Ошибка, Данные", Ложь, "", Неопределено);
	
	Если ПустаяСтрока(ТелоОтвета) Тогда
		ЗаписьЖурналаРегистрации(
        	"Обмен с RetailCRM.ПустойОтвет",
        	УровеньЖурналаРегистрации.Предупреждение,
        	,
        	,
        	"CRM вернула пустой ответ на запрос: " + Адрес
   		);
		Результат.Ошибка = "CRM вернула пустой ответ.";
        Возврат Результат;
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	///	
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
        Данные = ПреобразоватьJSONВСтруктуры(Данные);		
	///	
		ЧтениеJSON.Закрыть();
	Исключение  
		  ЗаписьЖурналаРегистрации(
	        "Обмен с RetailCRM.ОшибкаJSON",
	        УровеньЖурналаРегистрации.Ошибка,
	        ,
	        ,
	        "Не удалось разобрать JSON." + Символы.ПС +
	        "Ошибка: " + ОписаниеОшибки() + Символы.ПС +
	        "Ответ CRM (первые 500 символов): " + Лев(ТелоОтвета, 500)
		  );
	    Результат.Ошибка = "CRM вернула некорректный ответ.";
        Возврат Результат;
	КонецПопытки;
	
	Если Данные.Свойство("success") И НЕ Данные.success Тогда
		Если Данные.Свойство("errorMsg") Тогда
			ЗаписьЖурналаРегистрации(
        		"Обмен с RetailCRM.ОшибкаСети",
       	 		УровеньЖурналаРегистрации.Ошибка,
        		,
        		,
        		"Ошибка сети: " + Данные.errorMsg + Символы.ПС +
        		"URL запроса: " + Адрес
    		);
			ТекстСетевойОшибки = Данные.errorMsg;
			ПонятныйТекст = Расш1_НастройкиОбмена.РасшифроватьОшибку(ТекстСетевойОшибки);  
			Результат.Ошибка = ПонятныйТекст;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли; 

	Результат.Успех = Истина;
    Результат.Данные = Данные;
    Возврат Результат;   
	

КонецФункции // ()

Функция ПреобразоватьJSONВСтруктуры(Значение)

    Если ТипЗнч(Значение) = Тип("Массив") Тогда
        Результат = Новый Массив;
        Для Каждого Элемент Из Значение Цикл
            Результат.Добавить(
                ПреобразоватьJSONВСтруктуры(Элемент)
            );
        КонецЦикла;
        Возврат Результат;
    КонецЕсли;

    Если ТипЗнч(Значение) <> Тип("Соответствие") Тогда
        Возврат Значение;
    КонецЕсли;

    Результат = Новый Структура;

    Для Каждого Пара Из Значение Цикл
        Ключ = Пара.Ключ;
        Элемент = ПреобразоватьJSONВСтруктуры(Пара.Значение);
        Попытка
            Результат.Вставить(Ключ, Элемент);
        Исключение
            Возврат Значение;
        КонецПопытки;
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ПолучитьШапкуДокументаЗаказа(Заказы) Экспорт
	
	IDЗаказа = Заказы.ID;
    НомерЗаказа = Заказы.number;
    ДатаСоздана = Заказы.createdAt;
        Год = Число(Лев(ДатаСоздана,4));
        Месяц = Число(Сред(ДатаСоздана, 6, 2));
        День = Число(Сред(ДатаСоздана, 9, 2));
        Час = Число(Сред(ДатаСоздана, 12, 2));
        Минута = Число(Сред(ДатаСоздана, 15, 2));
        Секунда = Число(Сред(ДатаСоздана, 18, 2));
        ДатаСоздана = Дата(Год, Месяц, День, Час, Минута, Секунда);
    
    СтруктураШапки = Новый Структура; 
	СтруктураШапки.Вставить("IDЗаказа", IDЗаказа);
    СтруктураШапки.Вставить("НомерЗаказа", НомерЗаказа);
    СтруктураШапки.Вставить("ДатаСоздана", ДатаСоздана);
    
    Клиент = Заказы.customer;
    Фамилия = Клиент.lastName;
    Имя = Клиент.firstName;
	ФИ = Имя + " " + Фамилия;
    
    Телефон = "";
    Если Клиент.Свойство("phones") И Клиент.phones.Количество() > 0 Тогда
        Телефон = Клиент.phones[0].number;
    КонецЕсли;
    
   	СтруктураШапки.Вставить("КлиентФИ", ФИ);
	СтруктураШапки.Вставить("КлиентТелефон", Телефон);
    
    Возврат СтруктураШапки;
    
КонецФункции

Функция РасшифроватьОшибку(ТехническийТекст) Экспорт
    
       Словарь = Новый Соответствие;
	Словарь.Вставить("Couldn't resolve host name", "Не удалось подключиться к CRM. Проверьте адрес и интернет.");
	Словарь.Вставить("Could not connect", "Не удалось установить соединение с CRM. Проверьте интернет.");
	Словарь.Вставить("Ошибка работы с Интернет", "Не удалось подключиться к интернету. Проверьте соединение.");
    Словарь.Вставить("Connection timed out", "Сервер CRM не отвечает. Попробуйте позже.");
    Словарь.Вставить("Connection refused", "Сервер CRM отклонил подключение.");
    Словарь.Вставить("Network is unreachable", "Сеть недоступна. Проверьте интернет.");
    Словарь.Вставить("No route to host", "Нет маршрута к серверу. Проверьте интернет.");
    Словарь.Вставить("SSL", "Ошибка защищённого соединения. Обратитесь к администратору.");
	Словарь.Вставить("Wrong ""apiKey""", "Неверный API-ключ. Проверьте настройки обмена.");
    Словарь.Вставить("Wrong ""site""", "Неверный код магазина.");
	Словарь.Вставить("Account does not exist", "Аккаунт CRM не найден. Проверьте адрес CRM.");
    Словарь.Вставить("Unauthorized", "Доступ запрещён. Проверьте API-ключ.");
    Словарь.Вставить("Forbidden", "Доступ запрещён.");
	Словарь.Вставить("API method not found", "Метод API не найден. Проверьте адрес.");
    Словарь.Вставить("Not Found", "Ресурс не найден. Проверьте адрес API.");
    Словарь.Вставить("Internal Server Error", "Внутренняя ошибка CRM. Попробуйте позже.");
	Словарь.Вставить("Bad Request", "Некорректный запрос. Проверьте параметры.");
    Словарь.Вставить("Invalid JSON", "Некорректный формат данных.");

	Для Каждого Пара Из Словарь Цикл
        Если СтрНайти(ТехническийТекст, Пара.Ключ) > 0 Тогда
            Возврат Пара.Значение;
		КонецЕсли
    КонецЦикла;
    
    Возврат "Ошибка при обращении к CRM. Обратитесь к администратору.";
    
КонецФункции

//процедура и функции по выгрузке заказа в CRM

Процедура ВыгрузитьЗаказВCRM(Источник, Отказ, РежимПроведения) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Источник.Расш1_ID_CRM) Тогда
        Результат = СоздатьЗаказВCRM(Источник);
	Иначе
		Если Источник.Расш1_ЗагруженИзCRM Тогда  
			Сообщить("Заказ проведен. Заказ был загружен из CRM. Выгрузка обратно не требуется.");
			Возврат;
		Иначе
				Результат = ОбновитьЗаказВCRM(Источник, Источник.Расш1_ID_CRM);
		КонецЕсли;
	КонецЕсли; 

	Если Результат.Успех Тогда
		Если НЕ ЗначениеЗаполнено(Источник.Расш1_ID_CRM) Тогда 
			Данные = Результат.Данные;
		    Источник.Расш1_ID_CRM = Данные.externalId;
            Источник.Расш1_НомерCRM = Данные.Номер;
			Источник.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		Сообщить("Заказ проведен и выгружен в CRM.");
    Иначе
        Сообщить("Заказ проведён, но не выгружен в CRM: " + Результат.Ошибка);
    КонецЕсли;
	
КонецПроцедуры

Функция СоздатьЗаказВCRM(Источник)
	
	Результат = Новый Структура("Успех, Ошибка, Данные", Ложь, "", Неопределено);
	
	Настройки = ПолучениеНастроек();
	Если НЕ Настройки.Успех Тогда
		Результат.Ошибка = Настройки.Ошибка;
    	Возврат Результат;	
	КонецЕсли;
	
	Наименование = Источник.Контрагент.Наименование;
	Части = СтрРазделить(Наименование, " ", Ложь);

	Если Части.Количество() >= 2 Тогда
	    Фамилия = Части[0];
	    Имя = Части[1];
	Иначе
	    Фамилия = Наименование;
	    Имя = "";
	КонецЕсли;
	
	Телефон = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ ПЕРВЫЕ 1
	    |	КонтактнаяИнформация.Представление КАК Представление
	    |ИЗ
	    |	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтактнаяИнформация
	    |ГДЕ
	    |	КонтактнаяИнформация.Ссылка = &Контрагент
	    |	И КонтактнаяИнформация.Тип = &ТипТелефон";
	Запрос.УстановитьПараметр("Контрагент", Источник.Контрагент);
	Запрос.УстановитьПараметр("ТипТелефон", Перечисления.ТипыКонтактнойИнформации.Телефон);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
	    Телефон = Выборка.Представление;
	КонецЕсли;

	ВыборкаНастроек = Настройки.Данные;
	ВыборкаНастроек.Следующий();
	
	//создание json
	ЗаказJSON = Новый Структура;
		ЗаказJSON.Вставить("firstName", Имя);
		ЗаказJSON.Вставить("lastName", Фамилия);
		ЗаказJSON.Вставить("phone", Телефон);
		ЗаказJSON.Вставить("site", ВыборкаНастроек.КодМагазина);
		ЗаказJSON.Вставить("externalId", Источник.Номер);
		
	МассивТоваров = Новый Массив;
	Для Каждого СтрокаТовара Из Источник.Товары Цикл
	    ТоварJSON = Новый Структура; 
		//ВнешнийID = СтрокаТовара.Номенклатура.Артикул;
		ВнешнийID = СтрокаТовара.Номенклатура.Код;
		Offer = Новый Структура;
		    Offer.Вставить("externalId", ВнешнийID);
		    ТоварJSON.Вставить("offer", Offer);	   
			ТоварJSON.Вставить("quantity", СтрокаТовара.Количество);
	    ТоварJSON.Вставить("initialPrice", СтрокаТовара.Цена);
	    МассивТоваров.Добавить(ТоварJSON);
	КонецЦикла;
	ЗаказJSON.Вставить("items", МассивТоваров);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ");
	ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
	ЗаписатьJSON(ЗаписьJSON, ЗаказJSON);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	//запрос
	ТелоЗапроса = "order=" + СтрокаJSON; 

	Адрес = "/api/v5/orders/create?apiKey=" 
			+ ВыборкаНастроек.APIключ + "&site=" + ВыборкаНастроек.КодМагазина;
			
	ТелоОтвета = УстановкаСоединения(ВыборкаНастроек.АдресCRM, Адрес, "POST", ТелоЗапроса);	

	Если НЕ ТелоОтвета.Успех Тогда
	    Результат.Ошибка = ТелоОтвета.Ошибка;
	    Возврат Результат;
	КонецЕсли; 
	
	Ответ = ЧтениеJSON(ТелоОтвета.Данные, Адрес);
	Если НЕ Ответ.Успех Тогда
	    Результат.Ошибка = Ответ.Ошибка;
	    Возврат Результат;
	КонецЕсли; 
	
	ДанныеОтвета = Ответ.Данные;
	Если НЕ ДанныеОтвета.Свойство("success") ИЛИ НЕ ДанныеОтвета.success Тогда
		Результат.Ошибка = "CRM вернула ошибку при создании заказа";
		Возврат Результат;
	КонецЕсли;

	Если НЕ ДанныеОтвета.Свойство("order") Тогда
		Результат.Ошибка = "CRM не вернула данные заказа";
		Возврат Результат;
	КонецЕсли;
	
	ExternalID = Источник.Номер;
	НомерЗаказа = ДанныеОтвета.order.number;

	Результат.Успех = Истина;
	Результат.Данные = Новый Структура("externalId, Номер", ExternalID, НомерЗаказа);
	Возврат Результат;

КонецФункции // ()  

