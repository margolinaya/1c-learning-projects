
&НаСервере
Функция ЗагрузитьПоIDНаСервере(ID)
	
	//получение настроек обмена, установкасоединения, чтение полученного json
	Настройки = Расш1_НастройкиОбмена.ПолучениеНастроек();
	
	Если НЕ Настройки.Успех Тогда
		Возврат Настройки.Ошибка;	
	КонецЕсли;

	ВыборкаНастроек = Настройки.Данные;
	ВыборкаНастроек.Следующий();

	Адрес = "/api/v5/orders?site=" + ВыборкаНастроек.КодМагазина 
			+ "&apiKey=" + ВыборкаНастроек.APIключ
			+ "&filter[ids][]=" + Строка(ID);
	
	ТелоОтвета = Расш1_НастройкиОбмена.УстановкаСоединения(ВыборкаНастроек.АдресCRM,Адрес);
	Если НЕ ТелоОтвета.Успех Тогда
			Возврат ТелоОтвета.Ошибка;		
	КонецЕсли;
		
	Ответ = Расш1_НастройкиОбмена.ЧтениеJSON(ТелоОтвета.Данные, Адрес);
	Если НЕ Ответ.Успех Тогда
		Возврат Ответ.Ошибка;	
	КонецЕсли; 
	ДанныеЗаказа = Ответ.Данные;
	
	Если ДанныеЗаказа.orders.Количество() = 0 Тогда
    	Возврат "Заказ с ID " + ID + " не найден в CRM";
	КонецЕсли;
	Заказы = ДанныеЗаказа.orders[0];   
	
	//разбор json - шапка документа
	СтруктураШапки = Расш1_НастройкиОбмена.ПолучитьШапкуДокументаЗаказа(Заказы);
	НомерЗаказа = СтруктураШапки.НомерЗаказа;
	ДатаЗаказа = СтруктураШапки.ДатаСоздана;
	КлиентФИ = СтруктураШапки.КлиентФИ;
	КлиентТелефон = СтруктураШапки.КлиентТелефон;  

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.Расш1_НомерCRM = &НомерCRM
		|	И НЕ ЗаказКлиента.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("НомерCRM", НомерЗаказа);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();  
	
	Если НЕ Выборка.Следующий() Тогда
		ДокументПоЗаказу = Документы.ЗаказКлиента.СоздатьДокумент();
		ДокументПоЗаказу.Дата = ДатаЗаказа; 		
		ДокументПоЗаказу.Статус = Перечисления.СтатусыЗаказовКлиентов.НеСогласован;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Заказ " + НомерЗаказа + " успешно загружен!";		
	Иначе
		ДокументПоЗаказу = Выборка.Ссылка.ПолучитьОбъект();
		ДокументПоЗаказу.Товары.Очистить();
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Заказ " + НомерЗаказа + " успешно обновлен!";
	КонецЕсли; 
	
	/// Добавлено: заполнение шапки ----------
		ДокументПоЗаказу.Партнер = Справочники.Партнеры.НайтиПоКоду("00-00000003");
		//ДокументПоЗаказу.Контрагент = Справочники.Контрагенты.НайтиПоКоду("00-00000003");
		ДокументПоЗаказу.Валюта = Справочники.Валюты.НайтиПоКоду("643");
		ДокументПоЗаказу.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний"); 
		ДокументПоЗаказу.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
		ДокументПоЗаказу.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
		
		ДокументПоЗаказу.Расш1_ЗагруженИзCRM = Истина;
	/// ----------
		
		ДокументПоЗаказу.Расш1_НомерCRM = НомерЗаказа;
		ДокументПоЗаказу.Расш1_ID_CRM = ДокументПоЗаказу.Номер;
		ДокументПоЗаказу.Расш1_КлиентФИ = КлиентФИ;
		ДокументПоЗаказу.Расш1_КлиентТелефон = КлиентТелефон;
		ДокументПоЗаказу.Организация = ВыборкаНастроек.Организация;
		ДокументПоЗаказу.Склад = ВыборкаНастроек.Склад;
		
	//разбор json - таблица товаров
	ВсеТоварыНайдены = Истина;
	Ненайденные = "";   
	
	Если НЕ Заказы.Свойство("items") ИЛИ Заказы.items.Количество() = 0 Тогда
		Возврат "В заказе " + Заказы.number + " нет ни одного товара.";
	КонецЕсли;
	
	МассивАртикулов = Новый Массив;
	Для каждого Товар Из Заказы.items Цикл
		Артикул = Товар.offer.article; 
		МассивАртикулов.Добавить(Артикул);
	КонецЦикла; 
	
	Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Номенклатура.Артикул КАК Артикул,
			|	Номенклатура.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
		    |ГДЕ
			|	Номенклатура.Артикул В (&МассивАртикулов)";
		
		Запрос.УстановитьПараметр("МассивАртикулов", МассивАртикулов); 
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		СоответствиеАртикулСсылка = Новый Соответствие;
		Пока Выборка.Следующий() Цикл
			СоответствиеАртикулСсылка.Вставить(Выборка.Артикул, Выборка.Ссылка);
	    КонецЦикла;
	
	Для каждого Товар Из Заказы.items Цикл	
        Артикул = Товар.offer.article;
		Ссылка = СоответствиеАртикулСсылка.Получить(Артикул);
		Если Ссылка = Неопределено Тогда
			ВсеТоварыНайдены = Ложь ;
			Ненайденные = Ненайденные + Артикул + " ";
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ Ненайденные = "" Тогда
		Возврат "Не удалось записать заказ. Номенклатуры с артикулами: " + Ненайденные + " нет в базе!"; 	
	КонецЕсли;
		
	Для каждого Товар Из Заказы.items Цикл 
		Артикул = Товар.offer.article;
		Ссылка = СоответствиеАртикулСсылка.Получить(Артикул);

		Если ЗначениеЗаполнено(Товар.initialPrice) Тогда
	        Цена = Товар.initialPrice;
		КонецЕсли; 
		Если ЗначениеЗаполнено(Товар.quantity) Тогда
  			 Количество = Товар.quantity;
   		КонецЕсли;
				
		Строка = ДокументПоЗаказу.Товары.Добавить();
		Строка.Номенклатура = Ссылка;
		Строка.КоличествоУпаковок = Количество;
	///
		Строка.Количество = Количество;
	///
		Строка.Цена = Цена; 
		Строка.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.РезервироватьПоМереПоступления;
		Строка.ПроцентРучнойСкидки = 0;
		Строка.Сумма = Строка.КоличествоУпаковок * Строка.Цена;
	КонецЦикла;	
	
	Сообщение.Сообщить();
	
	ДокументПоЗаказу.Записать(); 

	Возврат "";
	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьПоID(Команда)
	
	ID = ЭтотОбъект.IDЗаказа;
	Если НЕ ЗначениеЗаполнено(ID) Тогда
		ПоказатьПредупреждение(,"Введите ID заказа.");
	Иначе
		Результат = ЗагрузитьПоIDНаСервере(ID);
		Если не Результат = "" Тогда
			ПоказатьПредупреждение(,Результат);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция ЗагрузитьПоДатеНаСервере(ДатаЗагрузки)
	
	//получение настроек обмена, установкасоединения, чтение полученного json
	Настройки = Расш1_НастройкиОбмена.ПолучениеНастроек();
	
	Если НЕ Настройки.Успех Тогда
		Возврат Настройки.Ошибка;	
	КонецЕсли;
	
	ВыборкаНастроек = Настройки.Данные;
	ВыборкаНастроек.Следующий();

	ТекущаяСтраница = 1;
	Пока Истина Цикл
	
		Адрес = "/api/v5/orders?limit=20&page=" + ТекущаяСтраница
				+ "&site=" + ВыборкаНастроек.КодМагазина 
				+ "&apiKey=" + ВыборкаНастроек.APIключ 
				+ "&filter[createdAtFrom]=" + Строка(Формат(ДатаЗагрузки,"ДФ=yyyy-MM-dd"))
				+ "&filter[createdAtTo]=" + Строка(Формат(ДатаЗагрузки,"ДФ=yyyy-MM-dd"));		
				
		ТелоОтвета = Расш1_НастройкиОбмена.УстановкаСоединения(ВыборкаНастроек.АдресCRM,Адрес);
		Если НЕ ТелоОтвета.Успех Тогда
			Возврат ТелоОтвета.Ошибка;		
		КонецЕсли; 
		
		Ответ = Расш1_НастройкиОбмена.ЧтениеJSON(ТелоОтвета.Данные, Адрес);
		Если НЕ Ответ.Успех Тогда
			Возврат Ответ.Ошибка;	
		КонецЕсли; 
		ДанныеЗаказа = Ответ.Данные;
		
		//разбор json - шапка документа
        МассивНомеров = Новый Массив; 
		МассивАртикулов = Новый Массив;
		СоответствиеЗаказа = Новый Соответствие;
		Для каждого Заказы Из ДанныеЗаказа.orders Цикл
			
			Если НЕ Заказы.Свойство("items") ИЛИ Заказы.items.Количество() = 0 Тогда
				Сообщить("В заказе " + Заказы.number + " нет ни одного товара.");
			Продолжить;
			КонецЕсли;
			
			СтруктураШапки = Расш1_НастройкиОбмена.ПолучитьШапкуДокументаЗаказа(Заказы);
			НомерЗаказа = СтруктураШапки.НомерЗаказа;
			МассивНомеров.Добавить(НомерЗаказа);
			
			ДатаЗаказа = СтруктураШапки.ДатаСоздана; 
			СоответствиеЗаказа.Вставить(НомерЗаказа, ДатаЗаказа);
			
			Для Каждого Товар Из Заказы.items Цикл 		
				МассивАртикулов.Добавить(Товар.offer.article);
			КонецЦикла;
			
		КонецЦикла; 
		
		Если МассивНомеров.Количество() = 0 Тогда
			Ошибка = "Заказы за указанную дату не найдены.";
			Возврат Ошибка;
		КонецЕсли; 
		
		//проверка существования заказа и артикула товара
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ   
			|	ЗаказКлиента.Расш1_НомерCRM КАК НомерCRM,
			|	ЗаказКлиента.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ЗаказКлиента КАК ЗаказКлиента
			|ГДЕ
			|	ЗаказКлиента.Расш1_НомерCRM В (&МассивНомеров)
			|	И НЕ ЗаказКлиента.ПометкаУдаления";
			
		Запрос.УстановитьПараметр("МассивНомеров", МассивНомеров);
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать(); 	
		СоответствиеНомерСсылка = Новый Соответствие;
		Пока Выборка.Следующий() Цикл
			СоответствиеНомерСсылка.Вставить(Выборка.НомерCRM, Выборка.Ссылка);
		КонецЦикла;  
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Номенклатура.Артикул КАК Артикул,
			|	Номенклатура.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
		    |ГДЕ
			|	Номенклатура.Артикул В (&МассивАртикулов)";
		
		Запрос.УстановитьПараметр("МассивАртикулов", МассивАртикулов); 
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		СоответствиеАртикулСсылка = Новый Соответствие;
		Пока Выборка.Следующий() Цикл
			СоответствиеАртикулСсылка.Вставить(Выборка.Артикул, Выборка.Ссылка);
	    КонецЦикла;
				
		Для каждого Заказы Из ДанныеЗаказа.orders Цикл
			ВсеТоварыНайдены = Истина;
			Ненайденные = ""; 
			
			Если НЕ Заказы.Свойство("items") ИЛИ Заказы.items.Количество() = 0 Тогда
				Сообщить("В заказе " + Заказы.number + " нет ни одного товара");
			Продолжить;
			КонецЕсли;
		
			Для Каждого Товар Из Заказы.items Цикл
				Артикул = Товар.offer.article;
				Ссылка = СоответствиеАртикулСсылка.Получить(Артикул);
				Если Ссылка = Неопределено Тогда
					ВсеТоварыНайдены = Ложь ;
					Ненайденные = Ненайденные + Артикул + " ";
				КонецЕсли;
			КонецЦикла; 
			
			Если НЕ ВсеТоварыНайдены Тогда
				Сообщить("Заказ " + Заказы.number + " не загружен: не найдены товары " + Ненайденные);
				Продолжить;
			КонецЕсли;
			
			СсылкаНаДокумент = СоответствиеНомерСсылка.Получить(Заказы.number);
			Если СсылкаНаДокумент = Неопределено Тогда
				ДокументПоЗаказу = Документы.ЗаказКлиента.СоздатьДокумент();
				ДокументПоЗаказу.Статус = Перечисления.СтатусыЗаказовКлиентов.НеСогласован;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Заказ " + Заказы.number + " успешно загружен!";
			Иначе	
			    ДокументПоЗаказу = СсылкаНаДокумент.ПолучитьОбъект();
				ДокументПоЗаказу.Товары.Очистить();
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Заказ " + Заказы.number + " успешно обновлен!";
			КонецЕсли;	
			
			СтруктураШапки = Расш1_НастройкиОбмена.ПолучитьШапкуДокументаЗаказа(Заказы);
			IDЗаказа = СтруктураШапки.IDЗаказа;
			НомерЗаказа = СтруктураШапки.НомерЗаказа;
			КлиентФИ = СтруктураШапки.КлиентФИ;
			КлиентТелефон = СтруктураШапки.КлиентТелефон;
			ДатаЗаказа = СтруктураШапки.ДатаСоздана; 
			
			ДокументПоЗаказу.Дата = ДатаЗаказа;
			ДокументПоЗаказу.Расш1_ID_CRM = IDЗаказа;
			ДокументПоЗаказу.Расш1_НомерCRM = НомерЗаказа;
            ДокументПоЗаказу.Расш1_КлиентФИ = КлиентФИ;
			ДокументПоЗаказу.Расш1_КлиентТелефон = КлиентТелефон;
			
			//разбор json - таблица товаров
            Для каждого Товар Из Заказы.items Цикл
				Артикул = Товар.offer.article; 
				СсылкаНаНоменклатуру = СоответствиеАртикулСсылка.Получить(Артикул);			    
				
				Если ЗначениеЗаполнено(Товар.initialPrice) Тогда
			        Цена = Товар.initialPrice;
				КонецЕсли; 
				Если ЗначениеЗаполнено(Товар.quantity) Тогда
		  			 Количество = Товар.quantity;
		   		КонецЕсли;
			
				Строка = ДокументПоЗаказу.Товары.Добавить();
				Строка.Номенклатура = СсылкаНаНоменклатуру;
				Строка.КоличествоУпаковок = Количество;
				Строка.Цена = Цена; 
				Строка.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.РезервироватьПоМереПоступления;
				Строка.ПроцентРучнойСкидки = 0;
				Строка.Сумма = Строка.Цена * Строка.КоличествоУпаковок; 
				
			КонецЦикла;
			
			ДокументПоЗаказу.Записать();
			Сообщение.Сообщить();
			
		КонецЦикла;

		ТекущаяСтраница = ТекущаяСтраница + 1;
		Если ТекущаяСтраница > ДанныеЗаказа.pagination.totalPageCount Тогда
			Прервать;		
		КонецЕсли;
		
	КонецЦикла;
	
 	Возврат "";	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьПоДате(Команда) 
	
	ДатаЗагрузки = ЭтотОбъект.ДатаСозданияЗаказов;  
	Если НЕ ЗначениеЗаполнено(ДатаЗагрузки) Тогда
		 ПоказатьПредупреждение(,"Введите Дату заказа.");
    Иначе	
	    Результат = ЗагрузитьПоДатеНаСервере(ДатаЗагрузки);
		Если не Результат = "" Тогда
			ПоказатьПредупреждение(,Результат);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры




