
&НаСервере
Процедура СохранитьНаСервере(APIКлюч, АдресCRM, КодМагазина, Организация, Склад)
	
	МенеджерЗаписи = РегистрыСведений.Расш1_НастройкиОбмена.СоздатьМенеджерЗаписи();
	
	МенеджерЗаписи.АдресCRM = АдресCRM;
	МенеджерЗаписи.APIключ  = APIключ;
	МенеджерЗаписи.КодМагазина = КодМагазина;
	МенеджерЗаписи.Организация = Организация;
	МенеджерЗаписи.Склад = Склад;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	APIКлюч = ЭтотОбъект.APIКлюч;
	АдресCRM = ЭтотОбъект.АдресCRM;
	КодМагазина = ЭтотОбъект.КодМагазина;
	Организация = ЭтотОбъект.Организация;
	Склад = ЭтотОбъект.Склад;

	СохранитьНаСервере(APIКлюч, АдресCRM, КодМагазина, Организация, Склад); 
	
	Сообщить("Настройки обмена сохранены!");
	
КонецПроцедуры

&НаСервере
Функция ПроверитьПодключениеНаСервере(АдресCRM,КодМагазина,APIКлюч)
	
	Адрес = "/api/v5/orders?site=" + КодМагазина + "&apiKey=" + APIКлюч; 
    
    ТелоОтвета = Расш1_НастройкиОбмена.УстановкаСоединения(АдресCRM, Адрес);
    Если НЕ ТелоОтвета.Успех Тогда
        Возврат "Ошибка: " + ТелоОтвета.Ошибка;
    КонецЕсли;
    
    Ответ = Расш1_НастройкиОбмена.ЧтениеJSON(ТелоОтвета.Данные, Адрес);
    Если НЕ Ответ.Успех Тогда
        Возврат "Ошибка: " + Ответ.Ошибка;
    КонецЕсли;
    
    Возврат "Подключение проходит успешно.";
	
КонецФункции

&НаКлиенте
Процедура ПроверитьПодключение()
	
	Результат = ПроверитьПодключениеНаСервере(ЭтотОбъект.АдресCRM,ЭтотОбъект.КодМагазина,ЭтотОбъект.APIКлюч); 
	
	ПоказатьПредупреждение(,Результат);
		
КонецПроцедуры
